find_package(Git REQUIRED)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/../dependencies")

function(FetchSource Name Url Revision)
    set(Destination "${CMAKE_CURRENT_LIST_DIR}/../dependencies/${Name}")
    if(NOT EXISTS "${Destination}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" clone --no-checkout "${Url}" "${Destination}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${Destination}" checkout --detach "${Revision}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${Destination}" rev-parse HEAD OUTPUT_VARIABLE Actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT Actual STREQUAL Revision)
        message(FATAL_ERROR "Dependency ${Name} is at ${Actual}; expected ${Revision}")
    endif()
endfunction()

FetchSource(lsplant https://github.com/LSPosed/LSPlant.git 6ac2280d8d88e14f0864c26ac97c1dc96713bde1)
FetchSource(dobby https://github.com/jmpews/Dobby.git 0c29f641c7e932af9ff99f4abf9ef98040a5bbba)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_LIST_DIR}/../dependencies/dobby" apply --reverse --check "${CMAKE_CURRENT_LIST_DIR}/../patches/DobbyAndroid.patch" RESULT_VARIABLE DobbyPatched OUTPUT_QUIET ERROR_QUIET)
if(NOT DobbyPatched EQUAL 0)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_LIST_DIR}/../dependencies/dobby" apply "${CMAKE_CURRENT_LIST_DIR}/../patches/DobbyAndroid.patch" COMMAND_ERROR_IS_FATAL ANY)
endif()
FetchSource(xdl https://github.com/hexhacking/xDL.git 1e0b6254165a2ddcbd32f77a371700c69155acf8)
FetchSource(zygisk https://github.com/topjohnwu/zygisk-module-sample.git 7bb941ac8edfcffd1d23761e401c45ca95409dc1)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_LIST_DIR}/../dependencies/lsplant" submodule update --init --recursive lsplant/src/main/jni/external/dex_builder COMMAND_ERROR_IS_FATAL ANY)

set(CxxArchive "${CMAKE_CURRENT_LIST_DIR}/../dependencies/libcxx-full.aar")
if(NOT EXISTS "${CxxArchive}")
    file(DOWNLOAD "https://repo.maven.apache.org/maven2/org/lsposed/libcxx/libcxx-full/30.0.16248370/libcxx-full-30.0.16248370.aar" "${CxxArchive}" EXPECTED_HASH SHA256=bbe93ec17cf7cbe3d6d7dd305a645b4b61d7afc09dc048dc7db53149efb65e6e TLS_VERIFY ON SHOW_PROGRESS)
endif()
file(SHA256 "${CxxArchive}" CxxDigest)
if(NOT CxxDigest STREQUAL "bbe93ec17cf7cbe3d6d7dd305a645b4b61d7afc09dc048dc7db53149efb65e6e")
    message(FATAL_ERROR "Pinned libcxx archive checksum mismatch")
endif()
if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/../dependencies/libcxx-full/prefab/modules/cxx/include/prefab/cmake-config.cmake")
    file(ARCHIVE_EXTRACT INPUT "${CxxArchive}" DESTINATION "${CMAKE_CURRENT_LIST_DIR}/../dependencies/libcxx-full")
endif()
